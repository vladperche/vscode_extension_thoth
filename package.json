{
  "name": "thoth",
  "displayName": "Thoth",
  "description": "HTTP Request Client for VS Code .thoth files",
  "version": "0.4.0",
  "publisher": "VladimirPercheCruz",
  "repository": {
    "type": "git",
    "url": "https://github.com/vladperche/vscode_extension_thoth"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Network",
    "Other"
  ],
  "icon": "resources/icon.png",
  "activationEvents": [
    "onCustomEditor:thoth.editor",
    "onCustomEditor:thoth.curlEditor",
    "onCustomEditor:thoth.varsEditor",
    "onLanguage:thoth",
    "onLanguage:thothvars"
  ],
  "capabilities": {
    "workspaceTrust": {
      "supported": true
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Thoth Client",
      "properties": {
        "thoth-client.environmentVariables": {
          "type": "object",
          "scope": "resource",
          "default": {
            "$shared": {
              "baseUrl": "http://localhost:3000"
            }
          },
          "description": "Workspace secret environment variables for Thoth HTTP Client"
        }
      }
    },
    "languages": [
      {
        "id": "thoth",
        "aliases": [
          "Thoth HTTP Request",
          "thoth"
        ],
        "extensions": [
          ".thoth"
        ]
      },
      {
        "id": "thothvars",
        "aliases": [
          "Thoth Variables",
          "thothvars"
        ],
        "extensions": [
          ".thothvars"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "thoth.editor",
        "displayName": "Thoth HTTP Request",
        "selector": [
          {
            "filenamePattern": "*.thoth"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "thoth.curlEditor",
        "displayName": "Show curl",
        "selector": [
          {
            "filenamePattern": "*.thoth"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "thoth.varsEditor",
        "displayName": "Thoth Variables Editor",
        "selector": [
          {
            "filenamePattern": "*.thothvars"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "thoth.newRequest",
        "title": "Thoth: Create New HTTP Request"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.3"
  }
}
